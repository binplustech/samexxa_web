RewriteEngine On

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirect /faq to /faq.php
RewriteRule ^faq$ faq.php [L,NC]

# Optional: redirect other common pages
RewriteRule ^about-us$ about-us.php [L,NC]
RewriteRule ^contact-us$ contact-us.php [L,NC]
RewriteRule ^terms$ terms.php [L,NC]
RewriteRule ^privacy-policy$ privacy-policy.php [L,NC]
RewriteRule ^return-refund$ return-refund.php [L,NC]